{
  "name": "Hooandee Gallery",
  "display_name": "Hooandee Gallery",
  "author": "Hooandee",
  "version": "v0.4.9",
  "description": "Transforma Steam en una galería y un sistema glass coherente, con artwork dinámico, controles refinados y acentos elegantes configurables.",
  "target": "System-Wide",
  "manifest_version": 9,
  "inject": {
    "tokens.css": [
      "bigpicture",
      "QuickAccess",
      "MainMenu",
      "notificationtoasts.*"
    ],
    "home.css": [
      "bigpicture"
    ],
    "library.css": [
      "bigpicture"
    ],
    "details.css": [
      "bigpicture"
    ],
    "system.css": [
      "bigpicture"
    ],
    "downloads.css": [
      "bigpicture"
    ],
    "settings.css": [
      "bigpicture"
    ],
    "qam.css": [
      "QuickAccess"
    ],
    "main-menu.css": [
      "MainMenu"
    ],
    "notifications.css": [
      "notificationtoasts.*"
    ]
  },
  "patches": {
    "Color de acento": {
      "default": "Glaciar",
      "type": "slider",
      "values": {
        "Glaciar": {},
        "Champagne": {
          "options/accent-champagne.css": [
            "bigpicture",
            "QuickAccess",
            "MainMenu",
            "notificationtoasts.*"
          ]
        },
        "Salvia": {
          "options/accent-sage.css": [
            "bigpicture",
            "QuickAccess",
            "MainMenu",
            "notificationtoasts.*"
          ]
        }
      }
    },
    "Difuminado del fondo": {
      "default": "Medio",
      "type": "slider",
      "values": {
        "Desactivado": {
          "options/blur-off.css": [
            "bigpicture"
          ]
        },
        "Suave": {
          "options/blur-soft.css": [
            "bigpicture"
          ]
        },
        "Medio": {
          "options/blur-medium.css": [
            "bigpicture"
          ]
        },
        "Alto": {
          "options/blur-high.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Ocultar nombre del juego": {
      "default": "No",
      "type": "checkbox",
      "values": {
        "No": {},
        "Yes": {
          "options/hide-game-name.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Ocultar tiempo jugado": {
      "default": "No",
      "type": "checkbox",
      "values": {
        "No": {},
        "Yes": {
          "options/hide-playtime.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Contenido del header": {
      "default": "Completo",
      "type": "slider",
      "values": {
        "Completo": {},
        "Solo indicadores": {
          "options/header-indicators-only.css": [
            "bigpicture"
          ]
        },
        "Oculto": {
          "options/header-hidden.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Indicadores del header": {
      "default": "Batería y hora",
      "type": "slider",
      "values": {
        "Batería y hora": {},
        "Solo batería": {
          "options/header-only-battery.css": [
            "bigpicture"
          ]
        },
        "Solo hora": {
          "options/header-only-time.css": [
            "bigpicture"
          ]
        },
        "Ninguno": {
          "options/header-no-indicators.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Estilo de batería": {
      "default": "Hooandee",
      "type": "slider",
      "values": {
        "Hooandee": {
          "options/battery-hooandee.css": [
            "bigpicture",
            "QuickAccess"
          ]
        },
        "Steam": {}
      }
    },
    "Contenido del footer": {
      "default": "Completo",
      "type": "slider",
      "values": {
        "Completo": {},
        "Esencial": {
          "options/footer-essential.css": [
            "bigpicture"
          ]
        },
        "Oculto": {
          "options/footer-hidden.css": [
            "bigpicture"
          ]
        }
      }
    },
    "Estilo de iconos del footer": {
      "default": "Hooandee",
      "type": "slider",
      "values": {
        "Hooandee": {
          "options/footer-icons-hooandee.css": [
            "bigpicture"
          ]
        },
        "Steam": {}
      }
    }
  }
}
